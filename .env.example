DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/filesearch
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=./storage
UPLOAD_CHUNK_MAX_BYTES=16777216
INDEX_CHUNK_CHARS=1000
INDEX_CHUNK_OVERLAP_CHARS=150
INDEX_READ_BUFFER_BYTES=4194304
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SEARCH_CACHE_TTL_SECONDS=300
SECTION_CACHE_TTL_SECONDS=300
